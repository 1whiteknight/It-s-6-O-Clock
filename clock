<?xml version="1.0" encoding="UTF-8"?>
<svg
    xmlns="http://www.w3.org/2000/svg"
    width="300mm"
    height="300mm"
    viewBox="-10 -10 320 320">

    <!-- Außenkreis -->
    <circle cx="150" cy="150" r="150"
        fill="none" stroke="black" stroke-width="3" />

    <!-- Mittelpunkt -->
    <circle cx="150" cy="150" r="4" fill="black" />

    <!-- Uhrzeiger -->
    <g id="hands" transform="rotate(0 150 150)">
        <!-- Stundenzeiger -->
        <line id="hour"
            x1="150" y1="150"
            x2="150" y2="90"
            stroke="black"
            stroke-width="4"
            stroke-linecap="round" />

        <!-- Minutenzeiger -->
        <line id="minute"
            x1="150" y1="150"
            x2="150" y2="65"
            stroke="black"
            stroke-width="3"
            stroke-linecap="round" />

        <!-- Sekundenzeiger -->
        <line id="second"
            x1="150" y1="155"
            x2="150" y2="50"
            stroke="red"
            stroke-width="1.5"
            stroke-linecap="round" />
    </g>

         <!-- Mittelpunkt Sekundenzeiger -->
        <circle cx="150" cy="150" r="2" fill="red" />

    <!-- Text wie Uhrzahlen -->
    <g font-family="Arial" font-size="2mm"
       text-anchor="middle"
       dominant-baseline="middle"
       fill="black">

        <text x="150" y="25">1 (Cos0 + Cos0 + Cos0) = 6</text>
        <text x="210" y="45">(1 + 1 + 1)! = 6</text>
        <text x="255" y="90">2 + 2 +2 = 6</text>
        <text x="270" y="150">3 * 3 - 3 = 6</text>
        <text x="255" y="210">√4 + √4 + √4 = 6</text>
        <text x="210" y="255">5 / 5 + 5 = 6</text>
        <text x="150" y="275">6 - 6 + 6 = 6</text>
        <text x="90" y="255">7 - 7 / 7 = 6</text>
        <text x="45" y="210">8 - √(√(8 + 8)) = 6</text>
        <text x="30" y="150">√9 *√9 -√9 = 6</text>
        <text x="50" y="90">log(10 * 10 * 10)! =6</text>
        <text x="90" y="45">!3 = 1 * 2 * 3 = 6</text>
    </g>

    <!-- JavaScript für Zeitserver -->
    <script><![CDATA[
    function updateClock() {
        const now = new Date();

        const seconds = now.getSeconds();
        const minutes = now.getMinutes();
        const hours = now.getHours() % 12;

        const secAngle = seconds * 6;
        const minAngle = minutes * 6 + seconds * 0.1;
        const hourAngle = hours * 30 + minutes * 0.5;

        document.getElementById("second")
            .setAttribute("transform", `rotate(${secAngle} 150 150)`);

        document.getElementById("minute")
            .setAttribute("transform", `rotate(${minAngle} 150 150)`);

        document.getElementById("hour")
            .setAttribute("transform", `rotate(${hourAngle} 150 150)`);
    }

    updateClock();
    setInterval(updateClock, 1000);
]]></script>
